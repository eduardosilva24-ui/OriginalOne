NODE_ENV=development
PORT=3000
HOST=0.0.0.0
JWT_SECRET=your-secret-key-change-in-production

# Online production database. Leave empty for local SQLite development.
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DATABASE_SSL=1

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://eduardosilva24-ui.github.io

# Public backend URL used to build Community file links when frontend is on GitHub Pages.
# Example: https://wizplanning-api.onrender.com
PUBLIC_API_BASE=

# Store uploaded activity files in the database. Automatically enabled for PostgreSQL.
STORE_UPLOADS_IN_DB=0

# Optional first online account seed.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
SEED_USER_ROLE=teacher

TRUST_PROXY=1
MAX_UPLOAD_SIZE=10mb
